# Order matters, and systemd holds it: a oneshot runs each ExecStart in turn,
# and it stops at the first failure. So a rollup that fails keeps the day it
# had not read yet, because `partitions` never runs to drop it.
[Unit]
Description=Roll up the dnsrules query log, then move its partitions on
After=dnsrules-migrate.service
Requires=dnsrules-migrate.service

[Service]
Type=oneshot
User=dnsrules
Group=dnsrules
EnvironmentFile=/etc/dnsrules/dnsrules.env
ExecStart=/usr/local/bin/dnsrules rollup
ExecStart=/usr/local/bin/dnsrules partitions
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
