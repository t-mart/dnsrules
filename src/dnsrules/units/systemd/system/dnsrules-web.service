[Unit]
Description=The dnsrules website
After=network-online.target dnsrules-migrate.service
Wants=network-online.target
Requires=dnsrules-migrate.service

[Service]
User=dnsrules
Group=dnsrules
EnvironmentFile=/etc/dnsrules/dnsrules.env
ExecStart=/usr/local/bin/dnsrules serve
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
# A rule change writes a zone file, then reloads the zone through the control
# socket. Both paths belong to unbound, and the dnsrules user reaches them
# through the unbound group.
ReadWritePaths=/etc/unbound/rules -/run/unbound

[Install]
WantedBy=multi-user.target
