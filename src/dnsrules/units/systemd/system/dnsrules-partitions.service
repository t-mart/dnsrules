[Unit]
Description=Add the coming dnsrules query log partitions, and drop the old ones
After=dnsrules-migrate.service
Requires=dnsrules-migrate.service

[Service]
Type=oneshot
User=dnsrules
Group=dnsrules
EnvironmentFile=/etc/dnsrules/dnsrules.env
ExecStart=/usr/local/bin/dnsrules partitions
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
