# Copy to .env for development. The justfile loads it.
# On mace this becomes /etc/dnsrules/dnsrules.env, read by the systemd units.

DNSRULES_DEBUG=true
DNSRULES_TIME_ZONE=UTC

# Leave empty to generate a key per process, which ends sessions on restart.
# Required when the web server runs more than one worker.
DNSRULES_SECRET_KEY=

DNSRULES_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DNSRULES_CSRF_TRUSTED_ORIGINS=

DNSRULES_DB_NAME=dnsrules
DNSRULES_DB_USER=dnsrules
DNSRULES_DB_PASSWORD=
DNSRULES_DB_HOST=localhost
DNSRULES_DB_PORT=5432
# Use verify-full when the database is on another machine.
DNSRULES_DB_SSLMODE=prefer
