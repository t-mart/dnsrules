# Copy to .env for development. The justfile loads it.
# On mace this becomes /etc/dnsrules/dnsrules.env, read by the systemd units.

DNSRULES_DEBUG=true
DNSRULES_TIME_ZONE=UTC

# Leave empty to generate a key per process, which ends sessions on restart.
DNSRULES_SECRET_KEY=

# 172.17.0.1 is the docker bridge gateway. `just unbound` fetches the rules
# across it, so the development server has to answer on that name.
DNSRULES_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],172.17.0.1
DNSRULES_CSRF_TRUSTED_ORIGINS=

# Read by `dnsrules serve` and by `just dev`. nftables decides who reaches the
# port. `just unbound` fetches the rules across the docker bridge, so this
# cannot be loopback during development.
DNSRULES_BIND=0.0.0.0:8000

DNSRULES_DB_NAME=dnsrules
DNSRULES_DB_USER=dnsrules
DNSRULES_DB_PASSWORD=
DNSRULES_DB_HOST=localhost
DNSRULES_DB_PORT=5432
DNSRULES_DB_SSLMODE=disable

# unbound connects out to this address. It must match dnstap-ip in
# unbound.conf on the router. Loopback, because the stream is every DNS query
# in the house. `just ingest` overrides it, because the development resolver
# runs in a container and reaches the host across the bridge.
DNSRULES_DNSTAP_HOST=127.0.0.1
DNSRULES_DNSTAP_PORT=6000

# unbound's remote control, with control-use-cert: no. Loopback only. Run
# `just unbound` for a development resolver on this port.
DNSRULES_CONTROL_HOST=127.0.0.1
DNSRULES_CONTROL_PORT=8953

# The resolver the compose stack gives the dnsrules container. A container
# cannot reach the host resolver at 127.0.0.53, and the database answers to a
# tailnet name, so this defaults to tailscale MagicDNS.
COMPOSE_DNS=100.100.100.100
